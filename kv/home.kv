#:kivy 2.3.0

<HomeScreen>:
    name: 'home'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Saludo y fecha
                Label:
                    text: "[b]Buenos días, Camila[/b]"
                    markup: True
                    font_size: '24sp'
                    color: (0.957, 0.965, 0.980, 1)
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: "Lunes 2 de noviembre · 10:45"
                    font_size: '13sp'
                    color: (0.627, 0.682, 0.753, 1)
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Tarjeta: En curso (Fondo Azul)
                RelativeLayout:
                    size_hint_y: None
                    height: '115dp'
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 4
                        canvas.before:
                            Color:
                                rgba: (0.337, 0.537, 0.910, 1) # --bl
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14]

                        Label:
                            text: root.active_class_time
                            font_size: '11sp'
                            color: (0.063, 0.094, 0.153, 1)
                            halign: 'left'
                            size_hint_y: None
                            height: '16dp'
                            text_size: self.size

                        Label:
                            text: f"[b]{root.active_class_name}[/b]"
                            markup: True
                            font_size: '18sp'
                            color: (0.063, 0.094, 0.153, 1)
                            halign: 'left'
                            size_hint_y: None
                            height: '24dp'
                            text_size: self.size

                        Label:
                            text: root.active_class_room
                            font_size: '13sp'
                            color: (0.063, 0.094, 0.153, 0.9)
                            halign: 'left'
                            size_hint_y: None
                            height: '18dp'
                            text_size: self.size

                        Label:
                            text: root.next_class_info
                            font_size: '11sp'
                            color: (0.063, 0.094, 0.153, 0.8)
                            halign: 'left'
                            size_hint_y: None
                            height: '16dp'
                            text_size: self.size

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('schedule')

                # Tarjeta: Pendientes de hoy
                RelativeLayout:
                    size_hint_y: None
                    height: '95dp'
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 6
                        canvas.before:
                            Color:
                                rgba: (0.106, 0.149, 0.220, 1) # --sf
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14]

                        BoxLayout:
                            size_hint_y: None
                            height: '22dp'
                            Label:
                                text: "[b]Pendientes de hoy[/b]"
                                markup: True
                                font_size: '14sp'
                                halign: 'left'
                                text_size: self.size
                            Label:
                                text: f"[color=f2a65a][size=12sp]{root.reminders_count_text}[/size][/color]"
                                markup: True
                                halign: 'right'
                                size_hint_x: None
                                width: '100dp'
                                text_size: self.size

                        Label:
                            text: root.reminders_preview_text
                            font_size: '12sp'
                            color: (0.627, 0.682, 0.753, 1)
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('remind')

                # Tarjeta: Progreso del semestre
                RelativeLayout:
                    size_hint_y: None
                    height: '100dp'
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: (1, 1)
                        padding: [16, 12]
                        spacing: 6
                        canvas.before:
                            Color:
                                rgba: (0.106, 0.149, 0.220, 1) # --sf
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [14]

                        BoxLayout:
                            size_hint_y: None
                            height: '22dp'
                            Label:
                                text: "[b]Progreso del semestre[/b]"
                                markup: True
                                font_size: '14sp'
                                halign: 'left'
                                text_size: self.size
                            Label:
                                text: f"[color=39c98a][b]{root.progress_percent}%[/b][/color]"
                                markup: True
                                halign: 'right'
                                size_hint_x: None
                                width: '60dp'
                                font_size: '15sp'
                                text_size: self.size

                        CustomProgressBar:
                            value: root.progress_percent
                            bar_color: (0.224, 0.788, 0.541, 1)

                        Label:
                            text: root.progress_avg_text
                            font_size: '11sp'
                            color: (0.627, 0.682, 0.753, 1)
                            halign: 'left'
                            valign: 'middle'
                            size_hint_y: None
                            height: '18dp'
                            text_size: self.size

                    Button:
                        background_color: (0, 0, 0, 0)
                        size_hint: (1, 1)
                        on_release: root.navigate('progress')

                # Grilla de accesos rápidos (Tiles)
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: '170dp'
                    spacing: 10

                    TileButton:
                        icon_text: "📚"
                        title_text: "Materias"
                        on_release: root.navigate('subjects')

                    TileButton:
                        icon_text: "📅"
                        title_text: "Horario"
                        on_release: root.navigate('schedule')

                    TileButton:
                        icon_text: "🔢"
                        title_text: "Calculadora"
                        on_release: root.navigate('calc')

                    TileButton:
                        icon_text: "✎"
                        title_text: "Diario"
                        on_release: root.navigate('diary')

                    TileButton:
                        icon_text: "📊"
                        title_text: "Progreso"
                        on_release: root.navigate('progress')

                    TileButton:
                        icon_text: "🔔"
                        title_text: "Recordatorios"
                        on_release: root.navigate('remind')

        NavBar:
