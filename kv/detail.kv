#:kivy 2.3.0

<DetailScreen>:
    name: 'detail'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Botón Volver
                Button:
                    text: "‹  Volver"
                    size_hint: (None, None)
                    size: ('90dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (0.545, 0.718, 1.0, 1)
                    font_size: '15sp'
                    bold: True
                    on_release: app.go_back()

                # Título de Materia
                Label:
                    text: f"[b]{root.subject_title}[/b]"
                    markup: True
                    font_size: '24sp'
                    color: (0.957, 0.965, 0.980, 1)
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                # Campo Docente
                BoxLayout:
                    size_hint_y: None
                    height: '38dp'
                    spacing: 8
                    Label:
                        text: "Docente:"
                        size_hint_x: None
                        width: '65dp'
                        color: (0.627, 0.682, 0.753, 1)
                        font_size: '13sp'
                        halign: 'left'
                        text_size: self.size
                    StyledTextInput:
                        text: root.teacher_name
                        hint_text: "Nombre del docente"
                        on_text: root.on_teacher_changed(self.text)

                # Tarjeta: Promedio y Métricas
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '36dp'
                        Label:
                            text: "Promedio actual"
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '14sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: f"[b]{root.current_avg:.2f}[/b]"
                            markup: True
                            color: (0.224, 0.788, 0.541, 1) if root.current_avg >= 7.0 else (0.949, 0.651, 0.353, 1)
                            font_size: '26sp'
                            halign: 'right'
                            size_hint_x: None
                            width: '80dp'
                            text_size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: '20dp'
                        Label:
                            text: f"Evaluado: {root.evaluated_percent:.0f}%"
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '12sp'
                            halign: 'left'
                            text_size: self.size
                        Label:
                            text: f"Pendiente: {root.pending_percent:.0f}%"
                            color: (0.627, 0.682, 0.753, 1)
                            font_size: '12sp'
                            halign: 'right'
                            text_size: self.size

                    CustomProgressBar:
                        value: root.evaluated_percent
                        bar_color: (0.224, 0.788, 0.541, 1)

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '66dp'
                        spacing: 12
                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4
                            Label:
                                text: "Nota mínima"
                                font_size: '11sp'
                                color: (0.627, 0.682, 0.753, 1)
                                size_hint_y: None
                                height: '16dp'
                                halign: 'left'
                                text_size: self.size
                            StyledTextInput:
                                text: str(root.min_note)
                                input_filter: 'float'
                                on_text: root.on_min_changed(self.text)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 4
                            Label:
                                text: "Nota objetivo"
                                font_size: '11sp'
                                color: (0.627, 0.682, 0.753, 1)
                                size_hint_y: None
                                height: '16dp'
                                halign: 'left'
                                text_size: self.size
                            StyledTextInput:
                                text: str(root.goal_note)
                                input_filter: 'float'
                                on_text: root.on_goal_changed(self.text)

                # Tarjeta Diagnóstico
                DarkCard:
                    Label:
                        text: f"[color=39c98a]{root.goal_status_text}[/color]"
                        markup: True
                        font_size: '13sp'
                        halign: 'left'
                        valign: 'middle'
                        size_hint_y: None
                        height: '24dp'
                        text_size: self.size

                    Label:
                        text: f"[color=f2a65a]{root.min_status_text}[/color]"
                        markup: True
                        font_size: '13sp'
                        halign: 'left'
                        valign: 'middle'
                        size_hint_y: None
                        height: '24dp'
                        text_size: self.size

                # Contenedor dinámico de categorías
                BoxLayout:
                    id: categories_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

                # Botones de acción
                PrimaryButton:
                    text: "+ Registrar evaluación"
                    on_release: root.open_evaluation_modal(0, -1)

                GhostButton:
                    text: "+ Nueva categoría"
                    on_release: root.open_new_category_modal()

        NavBar:
