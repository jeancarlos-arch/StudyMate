#:kivy 2.3.0

<ProfileScreen>:
    name: 'profile'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Encabezado
                Label:
                    text: "[b]Perfil[/b]"
                    markup: True
                    font_size: '24sp'
                    color: (0.957, 0.965, 0.980, 1)
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                # Tarjeta de Usuario
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '56dp'
                        spacing: 14

                        # Avatar Circular
                        Label:
                            text: "C"
                            font_size: '22sp'
                            bold: True
                            color: (0.063, 0.094, 0.153, 1)
                            size_hint: (None, None)
                            size: ('50dp', '50dp')
                            canvas.before:
                                Color:
                                    rgba: (0.337, 0.537, 0.910, 1)
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: 2
                            Label:
                                text: "[b]Camila Reyes[/b]"
                                markup: True
                                font_size: '16sp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size
                            Label:
                                text: "Ingeniería en Sistemas · 3.er semestre"
                                color: (0.627, 0.682, 0.753, 1)
                                font_size: '12sp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size

                # Enlaces de Navegación
                ProfileLinkCard:
                    icon_text: "🔔"
                    link_title: "Recordatorios"
                    on_release: root.navigate('remind')

                ProfileLinkCard:
                    icon_text: "📊"
                    link_title: "Progreso"
                    on_release: root.navigate('progress')

                ProfileLinkCard:
                    icon_text: "✎"
                    link_title: "Diario personal"
                    on_release: root.navigate('diary')

                ProfileLinkCard:
                    icon_text: "🔢"
                    link_title: "Calculadora"
                    on_release: root.navigate('calc')

                # Ajuste de Notificaciones
                DarkCard:
                    BoxLayout:
                        size_hint_y: None
                        height: '36dp'
                        Label:
                            text: "Notificaciones del sistema"
                            font_size: '14sp'
                            halign: 'left'
                            text_size: self.size
                        Switch:
                            active: root.notifications_enabled
                            size_hint_x: None
                            width: '80dp'
                            on_active: root.toggle_notifications(self.active)

        NavBar:
