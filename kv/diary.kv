#:kivy 2.3.0

<DiaryScreen>:
    name: 'diary'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: (0.063, 0.094, 0.153, 1) # --bg
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [20, 16]
                spacing: 12

                # Botón Volver
                Button:
                    text: "‹  Volver"
                    size_hint: (None, None)
                    size: ('90dp', '32dp')
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (0.545, 0.718, 1.0, 1)
                    font_size: '15sp'
                    bold: True
                    on_release: app.go_back()

                # Encabezado
                Label:
                    text: "[b]Mi diario[/b]"
                    markup: True
                    font_size: '24sp'
                    color: (0.957, 0.965, 0.980, 1)
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    height: '32dp'
                    text_size: self.size

                Label:
                    text: "Lunes 2 de noviembre de 2026"
                    font_size: '13sp'
                    color: (0.627, 0.682, 0.753, 1)
                    halign: 'left'
                    valign: 'top'
                    size_hint_y: None
                    height: '20dp'
                    text_size: self.size

                # Selector de Pestañas (Segmented Chips)
                BoxLayout:
                    size_hint_y: None
                    height: '42dp'
                    spacing: 10

                    Button:
                        text: "Nueva entrada"
                        font_size: '13sp'
                        bold: True
                        background_normal: ''
                        background_color: (0.337, 0.537, 0.910, 1) if root.active_tab == 0 else (0.106, 0.149, 0.220, 1)
                        color: (0.063, 0.094, 0.153, 1) if root.active_tab == 0 else (0.627, 0.682, 0.753, 1)
                        on_release: root.set_tab(0)

                    Button:
                        text: root.history_tab_title
                        font_size: '13sp'
                        bold: True
                        background_normal: ''
                        background_color: (0.337, 0.537, 0.910, 1) if root.active_tab == 1 else (0.106, 0.149, 0.220, 1)
                        color: (0.063, 0.094, 0.153, 1) if root.active_tab == 1 else (0.627, 0.682, 0.753, 1)
                        on_release: root.set_tab(1)

                # Contenedor dinámico de vista (Formulario o Historial)
                BoxLayout:
                    id: diary_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

        NavBar:
